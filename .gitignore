# Dependencies
node_modules/
.pnpm-store/

# pnpm-lock.yaml is the single committed, canonical lockfile.
# npm/yarn are blocked at install time (see preinstall script), so their
# lockfiles should never legitimately be generated — ignored regardless.
package-lock.json
yarn.lock

# Build outputs
dist/
build/
.next/
out/
coverage/
.turbo/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Terraform
# .terraform.lock.hcl is deliberately NOT ignored — like pnpm-lock.yaml, it
# pins exact provider versions and should be committed for reproducible
# applies across machines/CI.
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/*.tfstate
infrastructure/terraform/**/*.tfstate.*
infrastructure/terraform/**/*.tfplan
infrastructure/terraform/**/crash.log
infrastructure/terraform/**/terraform.tfvars
infrastructure/terraform/**/*.auto.tfvars

# Misc
*.tsbuildinfo
.claude/settings.local.json
