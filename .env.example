# This file documents every environment variable the platform expects.
# Copy to .env and fill in real values locally. Never commit real secrets.
# In deployed environments, values are injected via the secrets manager (see infrastructure/terraform).

# --- Database ---
DATABASE_URL=

# --- Redis (cache / queues) ---
REDIS_URL=

# --- Auth provider ---
AUTH_PROVIDER_API_KEY=
AUTH_PROVIDER_JWT_SECRET=

# --- Vapi ---
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# --- Object storage ---
S3_BUCKET_NAME=
S3_REGION=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- App ---
NODE_ENV=development
LOG_LEVEL=info
